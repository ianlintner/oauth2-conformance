{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ianlintner/oauth2-conformance/schemas/report.schema.json",
  "title": "Conformance run report",
  "description": "Machine-readable result of one conformance run, emitted by the runner as JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "implementation", "profile", "executed", "passed", "failed", "deferred", "results"],
  "properties": {
    "contract": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "executed": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "deferred": { "type": "integer", "minimum": 0 },
    "verdict": { "enum": ["pass", "fail"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "outcome"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "profile": { "type": "string" },
          "status": { "enum": ["draft", "stable", "reference-deviation", "retired"] },
          "outcome": { "enum": ["pass", "fail", "deferred"] },
          "diffs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "note": { "type": "string" }
        }
      }
    }
  }
}
