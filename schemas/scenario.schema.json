{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ianlintner/oauth2-conformance/schemas/scenario.schema.json",
  "title": "Conformance scenario",
  "description": "One black-box conformance scenario: ordered steps the runner executes against a system under test, with declared expectations. Evolved from the typescript-oauth2-server fixture format (request/expect/bind) plus captures and interpolation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "requirements", "profile", "status", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$",
      "description": "Dot-delimited stable identifier, e.g. core.pkce.wrong-verifier."
    },
    "title": { "type": "string", "minLength": 3 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[0-9])?-[A-Za-z0-9._-]+$" },
      "description": "Requirement IDs this scenario proves."
    },
    "profile": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Additional profiles this scenario is explicitly compatible with. Membership is opt-in: a scenario never enters a profile merely because that profile reuses one of its requirement IDs. Omit to run the scenario only under its canonical `profile`."
    },
    "status": { "$ref": "#/$defs/status" },
    "note": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "status": {
      "enum": ["draft", "stable", "reference-deviation", "retired"],
      "description": "Lifecycle of a scenario. Only stable runs count toward conformance."
    },
    "variable": {
      "type": "string",
      "minLength": 1,
      "description": "Template string; {{name}} or {{a.b}} interpolates a captured or generated value."
    },
    "stringRecord": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/variable" }
    },
    "nameValuePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/variable" }
      },
      "description": "One ordered form/query field; a list of these lets a parameter be repeated."
    },
    "nameValuePairList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nameValuePair" }
    },
    "formFields": {
      "description": "Form/query fields: either a string map or an ordered list of name/value pairs (list preserves duplicate keys).",
      "oneOf": [
        { "$ref": "#/$defs/stringRecord" },
        { "$ref": "#/$defs/nameValuePairList" }
      ]
    },
    "headerMatcher": {
      "description": "A response-header assertion: an exact value, or `$nonempty` / `$regex`.",
      "oneOf": [
        { "$ref": "#/$defs/variable" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "$nonempty": { "const": true },
            "$regex": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "headerExpectationRecord": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/headerMatcher" }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "use": {
          "type": "string",
          "enum": ["login-and-authorize", "logout", "device-verify", "dpop-proof", "dpop-nonce-mode", "client-assertion", "request-object", "mtls-request", "sut-restart", "request-on-instance", "read-logout-token", "frontchannel-capture", "prometheus-sample"],
          "description": "Runner helper invoked instead of a raw request. dpop-nonce-mode is implemented as a fail-closed control endpoint helper. mtls-request, sut-restart and request-on-instance are declared for draft scenarios only; the runner does not implement them yet, so a scenario using one defers (unknown step helper) and must stay draft. prometheus-sample extracts a numeric sample from captured Prometheus exposition text (runner-only; no SUT interface change)."
        },
        "with": { "type": "object", "additionalProperties": true },
        "request": { "$ref": "#/$defs/request" },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "description": "Bounded step repetition: replay the request `count` times, asserting `expect` each time (drives rate-limit buckets to their limit). Only valid with a `request`."
        },
        "expect": { "$ref": "#/$defs/expect" },
        "capture": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:text\\.body|(?:redirect\\.(?:query|fragment)|body|header|jwt\\.[A-Za-z_][A-Za-z0-9_]*\\.(?:header|payload))\\.[^\\s]+)$"
          }
        },
        "assert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "json": { "type": "object", "additionalProperties": true }
          },
          "description": "Post-capture assertion against the capture scope instead of a live response."
        },
        "source": {
          "type": "string",
          "pattern": "^jwt\\.[A-Za-z_][A-Za-z0-9_]*\\.payload$",
          "description": "When set, decode the JWT at this scope variable and use its payload as the assert body."
        }
      },
      "allOf": [
        {
          "if": { "required": ["use"] },
          "then": { "not": { "required": ["request", "assert"] } },
          "else": {
            "if": { "required": ["assert"] },
            "then": { "not": { "required": ["request"] } },
            "else": { "required": ["request", "expect"] }
          }
        },
        {
          "if": { "required": ["repeat"] },
          "then": {
            "required": ["request"],
            "not": { "required": ["use"] }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^\\\\\\s]*$",
          "description": "Server-local absolute path. Must not begin with // or contain a backslash."
        },
        "query": { "$ref": "#/$defs/formFields" },
        "form": { "$ref": "#/$defs/formFields" },
        "json": { "type": "object", "additionalProperties": true },
        "headers": { "$ref": "#/$defs/stringRecord" }
      },
      "not": { "required": ["form", "json"], "description": "A request carries either a form body or a JSON body, never both." }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["status"] },
        { "required": ["statusNot"] },
        { "required": ["redirectNot"] }
      ],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "statusNot": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "description": "Status codes that must not be returned, e.g. forbidden redirects." },
        "redirectNot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "location": { "type": "string", "minLength": 1, "description": "Location header that must not be returned (forbidden redirect target)." }
          },
          "description": "Forbidden redirect target assertions; a matching Location fails the scenario regardless of status code."
        },
        "headers": { "$ref": "#/$defs/headerExpectationRecord" },
        "json": { "type": "object", "additionalProperties": true },
        "jsonSchema": { "type": "object", "description": "Inline JSON Schema the normalized body must satisfy." },
        "redirect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "location": { "type": "string", "minLength": 1 },
            "locationPrefix": { "type": "string", "minLength": 1 },
            "query": { "$ref": "#/$defs/stringRecord" },
            "fragment": { "$ref": "#/$defs/stringRecord" },
            "formEncodedQuery": {
              "$ref": "#/$defs/stringRecord",
              "description": "Raw Location query values must be valid application/x-www-form-urlencoded serializations decoding to the given strings (equivalent encodings accepted)."
            }
          }
        }
      }
    }
  }
}