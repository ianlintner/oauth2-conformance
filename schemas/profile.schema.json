{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ianlintner/oauth2-conformance/schemas/profile.schema.json",
  "title": "Conformance profile",
  "description": "A named selection of requirements a server can claim. A server claiming a profile must pass every stable scenario belonging to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "requirements"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[0-9])?-[A-Za-z0-9._-]+$" }
    }
  }
}
