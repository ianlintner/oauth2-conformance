{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ianlintner/oauth2-conformance/schemas/seed.schema.json",
  "title": "Conformance SUT seed file",
  "description": "Test-mode-only state a system under test loads before a conformance run: clients, users, issuer and signing keys. Loaded via OAUTH2_CONFORMANCE_SEED=/path/seed.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["issuer", "clients", "users"],
  "properties": {
    "issuer": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "signingKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kid", "alg"],
        "properties": {
          "kid": { "type": "string", "minLength": 1 },
          "alg": { "type": "string", "pattern": "^(RS|ES|PS|HS)[0-9]{3}$" },
          "use": { "enum": ["sig"] }
        }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_id", "redirect_uris"],
        "allOf": [
          {
            "if": { "properties": { "public": { "const": true } }, "required": ["public"] },
            "then": {
              "not": { "required": ["client_secret"] },
              "properties": { "token_endpoint_auth_method": { "const": "none" } }
            }
          },
          {
            "if": {
              "properties": { "token_endpoint_auth_method": { "enum": ["client_secret_basic", "client_secret_post"] } },
              "required": ["token_endpoint_auth_method"]
            },
            "then": { "required": ["client_secret"] }
          },
          {
            "if": {
              "properties": { "token_endpoint_auth_method": { "const": "private_key_jwt" } },
              "required": ["token_endpoint_auth_method"]
            },
            "then": { "required": ["jwks"] }
          }
        ],
        "properties": {
          "client_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "client_secret": { "type": "string", "minLength": 1 },
          "token_endpoint_auth_method": {
            "enum": ["none", "client_secret_basic", "client_secret_post", "private_key_jwt"]
          },
          "public": { "type": "boolean" },
          "jwks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keys"],
            "properties": {
              "keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["kty"],
                  "properties": {
                    "kty": { "type": "string", "minLength": 1 },
                    "kid": { "type": "string", "minLength": 1 },
                    "alg": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "description": "Public-only JWK set (RFC 7517) the SUT uses to verify this client's private_key_jwt assertions and JAR request-object signatures. Values are synthetic test fixtures carrying no private key material; the runner-side signing helper generates the matching private key per run and publishes the public side via the helper output, which a scenario copies into this seed field."
          },
          "redirect_uris": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "scopes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "grant_types": {
            "type": "array",
            "items": { "enum": ["authorization_code", "refresh_token", "client_credentials", "urn:ietf:params:oauth:grant-type:device_code", "urn:ietf:params:oauth:grant-type:jwt-bearer"] }
          }
        }
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "minLength": 3 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "auto_approve_clients": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
