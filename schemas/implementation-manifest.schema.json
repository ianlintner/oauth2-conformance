{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ianlintner/oauth2-conformance/schemas/implementation-manifest.schema.json",
  "title": "Implementation conformance manifest",
  "description": "Declares how a server implementation pins and claims a conformance contract version. Lives in each port repository as conformance.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["implementation", "contract", "profiles"],
  "properties": {
    "implementation": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "contract": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "reason"],
        "properties": {
          "requirement": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[0-9])?-[A-Za-z0-9._-]+$" },
          "reason": { "type": "string", "minLength": 10 },
          "until": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
        }
      }
    }
  }
}
